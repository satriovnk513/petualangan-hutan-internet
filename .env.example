# ===========================================================================
# ENVIRONMENT VARIABLES — PETUALANGAN HUTAN INTERNET
# ===========================================================================
# Salin file ini ke ".env" dan isi nilainya.
# JANGAN commit file ".env" ke version control.
# File ini aman untuk di-commit karena tidak mengandung nilai rahasia.
# ===========================================================================

# ---------------------------------------------------------------------------
# VITE (frontend)
# ---------------------------------------------------------------------------
# Base URL untuk build (GitHub Pages atau domain sendiri).
# Contoh: /petualangan-hutan-internet/  atau  /
# VITE_BASE=/petualangan-hutan-internet/

# ---------------------------------------------------------------------------
# GOOGLE GEMINI API (Server-side / Netlify Functions / Local Vite Dev Proxy)
# ---------------------------------------------------------------------------
# Dapatkan API key dari Google AI Studio: https://aistudio.google.com/
# Variabel ini dibaca di server / backend / Vite dev server — BUKAN di frontend bundle.
#
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
#
# Jika GEMINI_API_KEY tidak disetel atau offline, chatbot secara otomatis
# berjalan dalam mode deterministik berbasis basis pengetahuan lokal (KB-00 s/d KB-10).
# ---------------------------------------------------------------------------
